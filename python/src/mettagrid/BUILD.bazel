load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("//tools:pyright.bzl", "py_library_typed")

# Python bindings for mettagrid. Bundles the pure-Python source tree with
# the pybind11-built mettagrid_c.so so `from mettagrid.mettagrid_c import
# ...` resolves out of the box for downstream consumers.
#
# The .so is built at //packages/mettagrid/cpp:mettagrid_c, which puts it at
# packages/mettagrid/cpp/mettagrid_c.so in runfiles. Python's import resolver
# needs it next to mettagrid/__init__.py — copy_file relocates it.

copy_file(
    name = "mettagrid_c_so",
    src = "//packages/mettagrid/cpp:mettagrid_c",
    out = "mettagrid_c.so",
)

py_library_typed(
    name = "mettagrid",
    srcs = glob(["**/*.py"]),
    data = [
        ":mettagrid_c_so",
        # Sprite atlas + map fixtures referenced at runtime via
        # importlib.resources.files("mettagrid.*"). Keep glob narrow —
        # listed file types match what the wheel ships under
        # python/src/mettagrid/.
    ] + glob(
        [
            "**/*.yaml",
            "**/*.json",
            "**/*.png",
            "**/*.map",
            "**/py.typed",
            "**/*.pyi",
        ],
        allow_empty = True,
    ),
    imports = [".."],  # so `import mettagrid` resolves at python/src/
    visibility = ["//visibility:public"],
    deps = [
        # Mirrors packages/mettagrid/pyproject.toml [project.dependencies]…
        "@pypi//boto3",
        "@pypi//botocore",
        "@pypi//numpy",
        "@pypi//gymnasium",
        "@pypi//importnb",
        "@pypi//pettingzoo",
        "@pypi//pydantic",
        "@pypi//protobuf",
        "@pypi//pyyaml",
        "@pypi//scipy",
        "@pypi//typer",
        "@pypi//requests",
        "@pypi//httpx",
        "@pypi//typing_extensions",
        # …plus direct imports not listed in pyproject.
        "@pypi//omegaconf",  # util/debug.py
        "@pypi//packaging",  # util/version.py uses packaging.version
    ],
    # Optional extras (`mettagrid[train]` pulls in pufferlib + torch + einops)
    # are imported statically by envs/, policy/, sdk/. The venv-based pyright
    # sees them because `uv sync` installs the extra; bazel needs them
    # spelled out for the typecheck. mettascope is a Nim package imported
    # lazily inside a function; the `# pyright: ignore` on that import
    # keeps it out of the typecheck dep list.
    typecheck_extra_deps = [
        "//packages/pufferlib-core:pufferlib",
        "@pypi//torch",
        "@pypi//einops",
        "@pypi//pytest",  # test_support/ files import pytest
    ],
)
