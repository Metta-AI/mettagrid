# BUILD.bazel for cpp/ directory
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@pybind11_bazel//:build_defs.bzl", "pybind_extension", "pybind_library")

# Compiler flags
COPTS = [
    "-std=c++20",
    "-fvisibility=hidden",
    "-DNPY_NO_DEPRECATED_API=NPY_1_7_API_VERSION",
    "-O3",
    "-DNDEBUG",
]

# Core C++ library for tests
pybind_library(
    name = "mettagrid_core",
    srcs = glob([
        "src/mettagrid/**/*.cpp",
    ]),
    hdrs = glob([
        "include/mettagrid/**/*.hpp",
    ]),
    copts = [
        "-std=c++20",
        "-DNPY_NO_DEPRECATED_API=NPY_1_7_API_VERSION",
        "-O3",
        "-DNDEBUG",
    ],
    includes = ["include/mettagrid"],
    visibility = ["//visibility:public"],
)

# Pybind11 binding sources, exposed as a cc_library so tests and benchmarks
# that need to link the bindings directly (instead of loading the .so as a
# Python module) can dep on this rather than re-listing sources + manual
# `-Icpp/...` copts. The cc_library `includes` attribute is bazel-aware and
# resolves to the package's repo prefix.
pybind_library(
    name = "mettagrid_bindings",
    srcs = [
        "bindings/mettagrid_c.cpp",
        "bindings/mettagrid_py.cpp",
        "bindings/profiling_py.cpp",
    ],
    hdrs = ["bindings/mettagrid_c.hpp"],
    copts = COPTS,
    includes = [".", "bindings"],
    visibility = ["//visibility:public"],
    deps = [":mettagrid_core"],
)

# Python bindings
pybind_extension(
    name = "mettagrid_c",
    srcs = [
        "bindings/mettagrid_c.cpp",
        "bindings/mettagrid_c.hpp",
        "bindings/mettagrid_py.cpp",
        "bindings/profiling_py.cpp",
    ] + glob([
        "src/mettagrid/**/*.cpp",
        "include/mettagrid/**/*.hpp",
    ]),
    copts = COPTS,
    includes = ["include/mettagrid", ".", "bindings"],
    visibility = ["//visibility:public"],
)

